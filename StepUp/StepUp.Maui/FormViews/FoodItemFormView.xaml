<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StepUp.Presentation.BaseViewModels;assembly=StepUp.Presentation"
    xmlns:controls="clr-namespace:StepUp.Maui.Controls"
    x:Class="StepUp.Maui.FormViews.FoodItemFormView"
    x:DataType="vm:FoodItemBaseViewModel">

    <Grid
        RowDefinitions="*,Auto">
        <ScrollView
            Grid.Row="0">
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,*">

                <Grid>
                    <Image
                        Source="{Binding ImageUrl}"
                        HeightRequest="280"
                        Aspect="AspectFill"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}" />

                    <ScrollView
                        VerticalOptions="End"
                        Orientation="Horizontal">
                        <Label
                            Text="{Binding Name}"
                            HorizontalTextAlignment="Center"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="White"
                            Padding="20,10"
                            Background="{StaticResource ImageOverlayGradient}" />
                    </ScrollView>

                    <ImageButton
                        x:Name="favButton"
                        Margin="0,10,10,0"
                        Source="{StaticResource IconNotFavourite}"
                        BackgroundColor="#55FFFFFF"
                        CornerRadius="22"
                        Padding="6"
                        WidthRequest="40"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        VerticalOptions="Start" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Margin="16,10,16,12"
                    Style="{StaticResource Card}"
                    Padding="16">
                    <VerticalStackLayout
                        Spacing="14">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="30">
                            <VerticalStackLayout
                                VerticalOptions="Center"
                                Spacing="6">
                                <Label
                                    Text="{Binding TotalNutrients.Calories, StringFormat='{0} ккал'}"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    FontFamily="impact"
                                    TextColor="{StaticResource NutriKcal}" />
                                <ProgressBar
                                    Progress="{Binding Progress}"
                                    ProgressColor="{StaticResource NutriKcal}"
                                    ScaleY="2"
                                    BackgroundColor="Transparent"
                                    Margin="0,-5"/>
                                <Label
                                    Text="{Binding DailyPercent, StringFormat='{0:F1}% от дневной нормы'}"
                                    Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <controls:MacroPieChart
                                Grid.Column="1"
                                ProteinPercent="{Binding ProteinPercent}"
                                FatPercent="{Binding FatPercent}"
                                CarbonPercent="{Binding CarbonPercent}"
                                WidthRequest="110"
                                HeightRequest="110"
                                HorizontalOptions="End" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="6"
                            RowSpacing="6"
                            ColumnDefinitions="Auto,*,Auto"
                            RowDefinitions="Auto,Auto,Auto">
                            <Border
                                BackgroundColor="{StaticResource NutriProtein}"
                                WidthRequest="10"
                                HeightRequest="10"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource NutriProtein}" />
                            <Label
                                Grid.Column="1"
                                Text="Белки"
                                Style="{StaticResource BodyLabel}" />
                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource BodyLabel}"
                                Text="{Binding TotalNutrients.Proteins, StringFormat='{0:F1} г'}" />

                            <Border
                                Grid.Row="1"
                                BackgroundColor="{StaticResource NutriFat}"
                                WidthRequest="10"
                                HeightRequest="10"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource NutriFat}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="Жиры"
                                Style="{StaticResource BodyLabel}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="2"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource BodyLabel}"
                                Text="{Binding TotalNutrients.Fat, StringFormat='{0:F1} г'}" />

                            <Border
                                Grid.Row="2"
                                BackgroundColor="{StaticResource NutriCarbon}"
                                WidthRequest="10"
                                HeightRequest="10"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource NutriCarbon}" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="Углеводы"
                                Style="{StaticResource BodyLabel}" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="2"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource BodyLabel}"
                                Text="{Binding TotalNutrients.Carbohydrates, StringFormat='{0:F1} г'}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Row="2"
                    Margin="16,0,16,12"
                    Style="{StaticResource CardFlat}"
                    Padding="14">
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="14">
                        <VerticalStackLayout
                            Spacing="6"
                            VerticalOptions="Center">
                            <Image
                                Source="{Binding NutriscoreGrade, Converter={StaticResource NutriscoreToImage}}"
                                WidthRequest="56" />
                            <Image
                                Source="{Binding NovaGroup, Converter={StaticResource NovaToImage}}"
                                WidthRequest="56" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4">
                            <Label
                                Text="Производитель:"
                                Style="{StaticResource SectionLabel}" />
                            <Label
                                Text="{Binding Brand}"
                                FontSize="15"
                                FontAttributes="Bold" />
                            <Label
                                Text="Штрих-код:"
                                Style="{StaticResource SectionLabel}"
                                Margin="0,6,0,0" />
                            <Label
                                Text="{Binding Barcode}"
                                FontSize="15"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <BoxView
                    Grid.Row="3"
                    HeightRequest="1"
                    Color="Transparent" />
            </Grid>
        </ScrollView>

        <Border
            Grid.Row="1"
            Style="{StaticResource Card}"
            StrokeShape="RoundRectangle 24,24,0,0"
            Padding="16,16,16,20"
            Margin="0,8,0,0">
            <VerticalStackLayout
                Spacing="10">
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10"
                    HeightRequest="50">
                    <Border
                        Style="{StaticResource InputBorder}"
                        Grid.Column="0"
                        WidthRequest="90">
                        <Entry
                            x:Name="entry"
                            Keyboard="Numeric"
                            Text="{Binding Amount, Mode=TwoWay}"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                    <Border
                        Style="{StaticResource InputBorder}"
                        Grid.Column="1"
                        Padding="8,2">
                        <Picker
                            FontSize="16"
                            SelectedItem="{Binding SelectedServing, Mode=TwoWay}"
                            ItemsSource="{Binding Servings}" />
                    </Border>
                </Grid>

                <Border
                    Style="{StaticResource InputBorder}"
                    Padding="8,2">
                    <Picker
                        FontSize="16"
                        Title="Приём пищи"
                        ItemsSource="{Binding MealOptions}"
                        SelectedItem="{Binding SelectedMeal, Mode=TwoWay}" />
                </Border>

                <Button
                    Text="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsSaveButtonActive}"
                    Style="{StaticResource PrimaryButton}" />

                <Button
                    Text="Удалить"
                    IsVisible="{Binding IsDeleteVisible}"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource DangerButton}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>