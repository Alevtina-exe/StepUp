<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StepUp.Presentation.BaseViewModels;assembly=StepUp.Presentation"
    xmlns:controls="clr-namespace:StepUp.Maui.Controls"
    x:Class="StepUp.Maui.FormViews.FoodItemFormView"
    x:DataType="vm:FoodItemBaseViewModel">
    <Grid
        RowDefinitions="*,Auto">
        <ScrollView
            Grid.Row="0">
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,*"
                BackgroundColor="{StaticResource PrimaryLight}">
                <Image
                    Source="{Binding ImageUrl}"
                    MaximumHeightRequest="280"
                    BackgroundColor="LightGray" />
                <ScrollView
                    VerticalOptions="End"
                    Orientation="Horizontal">
                    <Label
                        Text="{Binding Name}"
                        HorizontalTextAlignment="Center"
                        FontSize="30"
                        TextColor="White"
                        Padding="0,0,0,5"
                        Background="{StaticResource ImageOverlayGradient}" />

                </ScrollView>

                <ImageButton
                    x:Name="favButton"
                    Margin="0,5,5,0"
                    Source="{StaticResource IconNotFavourite}"
                    BackgroundColor="Transparent"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="End"
                    VerticalOptions="Start" />
                <Border
                    Grid.Row="1"
                    HorizontalOptions="Fill"
                    Padding="10"
                    StrokeShape="Rectangle"
                    Stroke="{StaticResource PrimaryLight}"
                    BackgroundColor="{StaticResource PrimaryLight}">
                    <Border
                        Style="{StaticResource WhiteCardFrame}"
                        Padding="20">
                        <VerticalStackLayout
                            Spacing="10">
                            <Grid
                                ColumnDefinitions="Auto,*"
                                RowDefinitions="Auto,*"
                                ColumnSpacing="20"
                                RowSpacing="10">

                                <controls:MacroPieChart
                                    ProteinPercent="{Binding ProteinPercent}"
                                    FatPercent="{Binding FatPercent}"
                                    CarbonPercent="{Binding CarbonPercent}"
                                    WidthRequest="120"
                                    HeightRequest="120"
                                    Grid.Column="1"
                                    HorizontalOptions="End"/>
                                <Grid
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="5,0"
                                    ColumnSpacing="5"
                                    RowSpacing="5"
                                    ColumnDefinitions="Auto,*,Auto"
                                    RowDefinitions="*,*,*">

                                    <Border
                                        BackgroundColor="{StaticResource NutriProtein}"
                                        Stroke="{StaticResource NutriProtein}"
                                        WidthRequest="10"
                                        HeightRequest="10"
                                        StrokeShape="RoundRectangle 10" />
                                    <Label
                                        Grid.Column="1"
                                        Text="Белки" />
                                    <Label
                                        Grid.Column="2"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding TotalNutrients.Proteins,
                                        StringFormat='{0:F1} г'}" />

                                    <Border
                                        Grid.Row="1"
                                        BackgroundColor="{StaticResource NutriFat}"
                                        Stroke="{StaticResource NutriFat}"
                                        WidthRequest="10"
                                        HeightRequest="10"
                                        StrokeShape="RoundRectangle 10" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Жиры" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding TotalNutrients.Fat,
                                        StringFormat='{0:F1} г'}" />

                                    <Border
                                        Grid.Row="2"
                                        BackgroundColor="{StaticResource NutriCarbon}"
                                        Stroke="{StaticResource NutriCarbon}"
                                        WidthRequest="10"
                                        HeightRequest="10"
                                        StrokeShape="RoundRectangle 10" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="Углеводы" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding TotalNutrients.Carbohydrates,
                                        StringFormat='{0:F1} г'}" />
                                </Grid>

                                <VerticalStackLayout
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Margin="10,0,0,0">
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontFamily="impact"
                                        FontSize="33"
                                        TextColor="{StaticResource NutriKcal}"
                                        Text="{Binding TotalNutrients.Calories, StringFormat='{0} ккал'}" />
                                    <ProgressBar
                                        Progress="{Binding Progress}"
                                        ScaleY="1.5"
                                        HorizontalOptions="Fill"
                                        ProgressColor="{StaticResource NutriKcal}" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Margin="0,2,0,0"
                                        FontFamily="impact"
                                        TextColor="{StaticResource NutriKcal}"
                                        Text="{Binding DailyPercent, StringFormat='{0:F1}% от дневной нормы'}" />
                                </VerticalStackLayout>
                            </Grid>


                        </VerticalStackLayout>
                    </Border>
                </Border>

                <ScrollView
                    Orientation="Horizontal"
                    Grid.Row="2">

                    <HorizontalStackLayout
                        Spacing="20"
                        Padding="20,10">
                        <VerticalStackLayout
                            Padding="0">
                            <Image
                                Source="{Binding NutriscoreGrade, Converter={StaticResource NutriscoreToImage}}"
                                WidthRequest="60" />
                            <Image
                                Source="{Binding NovaGroup, Converter={StaticResource NovaToImage}}"
                                WidthRequest="60" />

                        </VerticalStackLayout>
                        <VerticalStackLayout
                            HorizontalOptions="Start">
                            <Label
                                Text="Производитель:"
                                TextColor="{StaticResource TextSecondary}" />
                            <Label
                                Text="{Binding Brand}"
                                FontSize="16"
                                TextColor="{StaticResource TextSecondary}"
                                FontAttributes="Bold" />
                            <Label
                                Text="Штрихкод:"
                                TextColor="{StaticResource TextSecondary}" />
                            <Label
                                Text="{Binding Barcode}"
                                FontSize="16"
                                TextColor="{StaticResource TextSecondary}"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </ScrollView>

                <StackLayout
                    Orientation="Vertical"
                    Grid.Row="4"
                    Padding="20,10"
                    VerticalOptions="End"
                    Spacing="10"
                    BackgroundColor="{StaticResource ProductBottomPanel}">
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10"
                        HorizontalOptions="Fill"
                        HeightRequest="50">
                        <Border
                            Stroke="{StaticResource PrimaryDark}"
                            BackgroundColor="Transparent"
                            Padding="2"
                            Grid.Column="0"
                            StrokeShape="RoundRectangle 10">
                            <Entry
                                x:Name="entry"
                                WidthRequest="60"
                                Keyboard="Numeric"
                                Text="{Binding Amount, Mode=TwoWay}"
                                FontSize="20"
                                VerticalTextAlignment="End"
                                HorizontalTextAlignment="Center" />
                        </Border>
                        <Picker
                            FontSize="18"
                            SelectedItem="{Binding SelectedServing, Mode=TwoWay}"
                            HorizontalOptions="Fill"
                            Grid.Column="1"
                            VerticalTextAlignment="Center"
                            ItemsSource="{Binding Servings}" />
                    </Grid>
                    <Picker
                        FontSize="18"
                        Title="Приём пищи"
                        VerticalOptions="End"
                        ItemsSource="{Binding MealOptions}"
                        SelectedItem="{Binding SelectedMeal, Mode=TwoWay}" />
                    <Button
                        Text="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaveButtonActive}"
                        HorizontalOptions="Fill"
                        CornerRadius="20" />
                    <Button
                        Text="Удалить"
                        IsVisible="{Binding IsDeleteVisible}"
                        Command="{Binding DeleteCommand}"
                        CornerRadius="20" />
                </StackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
