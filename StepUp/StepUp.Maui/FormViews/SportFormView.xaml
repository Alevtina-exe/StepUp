<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StepUp.Maui.FormViews.SportFormView">
    <Grid
        RowDefinitions="Auto,*,*,Auto,*"
        RowSpacing="10"
        Padding="15"
        MinimumWidthRequest="200">
        <Label
            Margin="0,0,0,10"
            x:Name="TitleLabel"
            FontSize="16"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            TextColor="Black" />

        <Border
            Grid.Row="1"
            BackgroundColor="{StaticResource White}"
            Stroke="Transparent"
            Opacity="0.6"
            StrokeShape="RoundRectangle 20"
            Padding="10,0">
            <Entry
                x:Name="NameEntry"
                Placeholder="Название"
                TextChanged="OnEntryChanged"
                PlaceholderColor="{StaticResource TextSecondary}" />
        </Border>

        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource White}"
            Stroke="Transparent"
            Opacity="0.6"
            StrokeShape="RoundRectangle 30"
            Padding="10,0">
            <Entry
                x:Name="KcalEntry"
                Placeholder="Количество калорий"
                PlaceholderColor="{StaticResource TextSecondary}"
                Keyboard="Numeric"
                TextChanged="OnEntryChanged"/>
        </Border>
        <Label
            Grid.Row="3"
            x:Name="ErrorLabel"
            TextColor="{StaticResource ErrorColor}"
            HorizontalOptions="Center"
            IsVisible="False" />

        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,*,Auto"
            ColumnSpacing="5"
            HorizontalOptions="Fill">

            <Button
                x:Name="SaveButton"
                Text="OK"
                Clicked="OnSaveClicked"
                Style="{StaticResource PopupMenuButton}"
                Grid.Column="0" />
            <Button
                x:Name="CancelButton"
                Text="Отмена"
                Clicked="OnCancelClicked"
                Style="{StaticResource PopupMenuButton}"
                Grid.Column="1" />

            <Button
                x:Name="DeleteButton"
                Text="Удалить"
                Clicked="OnDeleteClicked"
                Style="{StaticResource PopupMenuButton}"
                Grid.Column="2"
                IsVisible="False" />
        </Grid>
    </Grid>
</ContentView>