<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StepUp.Maui.FormViews.SportFormView">
    <Grid
        RowDefinitions="Auto,*,*,Auto,*"
        RowSpacing="12"
        Padding="20"
        MinimumWidthRequest="260">

        <Label
            x:Name="TitleLabel"
            FontSize="18"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"
            Style="{StaticResource BodyLabel}" />

        <Border
            Grid.Row="1"
            Style="{StaticResource InputBorder}">
            <Entry
                x:Name="NameEntry"
                Placeholder="Название"
                TextChanged="OnEntryChanged" />
        </Border>

        <Border
            Grid.Row="2"
            Style="{StaticResource InputBorder}">
            <Entry
                x:Name="KcalEntry"
                Placeholder="Сожжено ккал"
                Keyboard="Numeric"
                TextChanged="OnEntryChanged" />
        </Border>

        <Label
            Grid.Row="3"
            x:Name="ErrorLabel"
            Style="{StaticResource ErrorLabel}"
            HorizontalOptions="Center"
            IsVisible="False" />

        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,*,Auto"
            ColumnSpacing="8">
            <Button
                x:Name="SaveButton"
                Text="OK"
                Clicked="OnSaveClicked"
                Style="{StaticResource PrimaryButton}"
                Grid.Column="0" />
            <Button
                x:Name="CancelButton"
                Text="Отмена"
                Clicked="OnCancelClicked"
                Style="{StaticResource SecondaryButton}"
                Grid.Column="1" />
            <Button
                x:Name="DeleteButton"
                Text="Удалить"
                Clicked="OnDeleteClicked"
                Style="{StaticResource DangerButton}"
                Grid.Column="2"
                IsVisible="False" />
        </Grid>
    </Grid>
</ContentView>