<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Base Colors -->
    <Color
        x:Key="Primary">#512BD4</Color>
    <Color
        x:Key="PrimaryDark">#562fc2</Color>
    <Color
        x:Key="PrimaryDarker">#3d0cc4</Color>
    <Color
        x:Key="PrimaryLight">#baa4f5</Color>
    <Color
        x:Key="Secondary">#DFD8F7</Color>
    <Color
        x:Key="SecondaryDarkText">#9880e5</Color>
    <Color
        x:Key="Tertiary">#2B0B98</Color>

    <!-- Backgrounds -->
    <Color
        x:Key="White">White</Color>
    <Color
        x:Key="Black">Black</Color>
    <Color
        x:Key="OffBlack">#1f1f1f</Color>
    <Color
        x:Key="ProductBottomPanel">#d4c4ff</Color>
    <Color
        x:Key="PopupBackground">#ccbbfc</Color>
    <Color
        x:Key="CardBackground">#E6FFFFFF</Color>
    <!-- Semi-transparent white -->

    <!-- Text Colors -->
    <Color
        x:Key="TextPrimary">#212121</Color>
    <Color
        x:Key="TextSecondary">#5d5d5d</Color>
    <Color
        x:Key="TextLight">White</Color>
    <Color
        x:Key="PlaceholderColor">#c8c8c8</Color>
    <Color
        x:Key="ErrorColor">Red</Color>
    <Color
        x:Key="AcceptColor">Green</Color>

    <!-- Grays -->
    <Color
        x:Key="Gray100">#E1E1E1</Color>
    <Color
        x:Key="Gray200">#C8C8C8</Color>
    <Color
        x:Key="Gray300">#ACACAC</Color>
    <Color
        x:Key="Gray400">#919191</Color>
    <Color
        x:Key="Gray500">#6E6E6E</Color>
    <Color
        x:Key="Gray600">#404040</Color>
    <Color
        x:Key="Gray900">#212121</Color>
    <Color
        x:Key="Gray950">#141414</Color>

    <!-- Nutrition Colors (Product Diagram) -->
    <Color
        x:Key="NutriProtein">#9fd5bd</Color>
    <Color
        x:Key="NutriFat">#fceda8</Color>
    <Color
        x:Key="NutriCarbon">#e79bc3</Color>
    <Color
        x:Key="NutriKcal">#b09a6d</Color>

    <!-- BMI Colors -->
    <Color
        x:Key="BmiDeficit">RoyalBlue</Color>
    <Color
        x:Key="BmiNormal">Green</Color>
    <Color
        x:Key="BmiOverweight">Yellow</Color>
    <Color
        x:Key="BmiObese1">Orange</Color>
    <Color
        x:Key="BmiObese2">Red</Color>
    <Color
        x:Key="BmiObese3">DarkRed</Color>

    <!-- Other -->
    <Color
        x:Key="Magenta">#D600AA</Color>
    <Color
        x:Key="MidnightBlue">#190649</Color>

    <!-- Brushes -->
    <SolidColorBrush
        x:Key="PrimaryBrush"
        Color="{StaticResource Primary}" />
    <SolidColorBrush
        x:Key="SecondaryBrush"
        Color="{StaticResource Secondary}" />
    <SolidColorBrush
        x:Key="TertiaryBrush"
        Color="{StaticResource Tertiary}" />
    <SolidColorBrush
        x:Key="WhiteBrush"
        Color="{StaticResource White}" />
    <SolidColorBrush
        x:Key="BlackBrush"
        Color="{StaticResource Black}" />

    <SolidColorBrush
        x:Key="Gray100Brush"
        Color="{StaticResource Gray100}" />
    <SolidColorBrush
        x:Key="Gray200Brush"
        Color="{StaticResource Gray200}" />
    <SolidColorBrush
        x:Key="Gray300Brush"
        Color="{StaticResource Gray300}" />
    <SolidColorBrush
        x:Key="Gray400Brush"
        Color="{StaticResource Gray400}" />
    <SolidColorBrush
        x:Key="Gray500Brush"
        Color="{StaticResource Gray500}" />
    <SolidColorBrush
        x:Key="Gray600Brush"
        Color="{StaticResource Gray600}" />
    <SolidColorBrush
        x:Key="Gray900Brush"
        Color="{StaticResource Gray900}" />
    <SolidColorBrush
        x:Key="Gray950Brush"
        Color="{StaticResource Gray950}" />

    <!-- Gradients -->
    <LinearGradientBrush
        x:Key="MainPageGradient"
        StartPoint="1,0"
        EndPoint="0,1">
        <GradientStop
            Color="{StaticResource PrimaryLight}"
            Offset="0.1" />
        <GradientStop
            Color="{StaticResource PrimaryDark}"
            Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush
        x:Key="ImageOverlayGradient"
        StartPoint="0,0"
        EndPoint="0,1">
        <GradientStop
            Color="Transparent"
            Offset="0.1" />
        <GradientStop
            Color="Gray"
            Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>