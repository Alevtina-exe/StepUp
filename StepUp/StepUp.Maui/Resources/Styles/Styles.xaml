<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--   SIZES   -->
    <x:Double
        x:Key="SizeTabIcon">24</x:Double>
    <x:Double
        x:Key="RadiusSmall">10</x:Double>
    <x:Double
        x:Key="RadiusMedium">16</x:Double>
    <x:Double
        x:Key="RadiusLarge">24</x:Double>
    <x:Double
        x:Key="RadiusPill">30</x:Double>
    <Thickness
        x:Key="PagePadding">20,24,20,24</Thickness>
    <Thickness
        x:Key="PagePaddingCompact">16</Thickness>

    <!--   BASE   -->
    <Style
        TargetType="ContentPage"
        ApplyToDerivedTypes="True">
        <Setter
            Property="Shell.NavBarIsVisible"
            Value="False" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <Style
        TargetType="Page"
        ApplyToDerivedTypes="True">
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <Style
        TargetType="Label">
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
        <Setter
            Property="FontFamily"
            Value="OpenSansRegular" />
        <Setter
            Property="FontSize"
            Value="14" />
    </Style>

    <Style
        TargetType="Entry">
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
        <Setter
            Property="FontFamily"
            Value="OpenSansRegular" />
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="PlaceholderColor"
            Value="{StaticResource PlaceholderColor}" />
        <Setter
            Property="MinimumHeightRequest"
            Value="44" />
        <Setter
            Property="MinimumWidthRequest"
            Value="44" />
    </Style>

    <Style
        TargetType="Picker">
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter
            Property="TitleColor"
            Value="{StaticResource PlaceholderColor}" />
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
        <Setter
            Property="FontFamily"
            Value="OpenSansRegular" />
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="MinimumHeightRequest"
            Value="44" />
    </Style>

    <Style
        TargetType="DatePicker">
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
    </Style>

    <Style
        TargetType="Button">
        <Setter
            Property="TextColor"
            Value="{StaticResource White}" />
        <Setter
            Property="BackgroundColor"
            Value="{StaticResource Primary}" />
        <Setter
            Property="FontFamily"
            Value="OpenSansRegular" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="BorderWidth"
            Value="0" />
        <Setter
            Property="CornerRadius"
            Value="24" />
        <Setter
            Property="Padding"
            Value="18,12" />
        <Setter
            Property="MinimumHeightRequest"
            Value="48" />
        <Setter
            Property="MinimumWidthRequest"
            Value="44" />
        <Setter
            Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup
                    x:Name="CommonStates">
                    <VisualState
                        x:Name="Normal" />
                    <VisualState
                        x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter
                                Property="BackgroundColor"
                                Value="{StaticResource PrimaryDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState
                        x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter
                                Property="BackgroundColor"
                                Value="{StaticResource PrimaryDarker}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState
                        x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter
                                Property="TextColor"
                                Value="{StaticResource White}" />
                            <Setter
                                Property="BackgroundColor"
                                Value="{StaticResource Gray300}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style
        TargetType="ImageButton">
        <Setter
            Property="Opacity"
            Value="1" />
        <Setter
            Property="BorderColor"
            Value="Transparent" />
        <Setter
            Property="BorderWidth"
            Value="0" />
        <Setter
            Property="CornerRadius"
            Value="0" />
        <Setter
            Property="MinimumHeightRequest"
            Value="44" />
        <Setter
            Property="MinimumWidthRequest"
            Value="44" />
    </Style>

    <Style
        TargetType="Border">
        <Setter
            Property="Stroke"
            Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter
            Property="StrokeThickness"
            Value="1" />
        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 16" />
    </Style>

    <Style
        TargetType="CollectionView">
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
    </Style>

    <Style
        TargetType="ScrollView">
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
    </Style>

    <!--  TYPOGRAPHY  -->
    <Style
        TargetType="Label"
        x:Key="DisplayLabel">
        <Setter
            Property="FontSize"
            Value="44" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />
        <Setter
            Property="FontFamily"
            Value="impact" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="TitleLabel">
        <Setter
            Property="FontSize"
            Value="28" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="HorizontalOptions"
            Value="Center" />
        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="SubtitleLabel">
        <Setter
            Property="FontSize"
            Value="20" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="HorizontalOptions"
            Value="Center" />
        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="SectionLabel">
        <Setter
            Property="FontSize"
            Value="12" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="TextTransform"
            Value="Uppercase" />
        <Setter
            Property="CharacterSpacing"
            Value="1.2" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="BodyLabel">
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="CaptionLabel">
        <Setter
            Property="FontSize"
            Value="12" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="ErrorLabel">
        <Setter
            Property="FontSize"
            Value="12" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorLight}}" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="Header">
        <Setter
            Property="TextTransform"
            Value="Uppercase" />
        <Setter
            Property="FontSize"
            Value="22" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="Padding"
            Value="0, 12, 0, 8" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="PFCLabel">
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource PrimaryDarker}, Dark={StaticResource PrimaryLight}}" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="FontSize"
            Value="16" />
        <Setter
            Property="VerticalTextAlignment"
            Value="Center" />
    </Style>

    <Style
        TargetType="Label"
        x:Key="PFCNameLabel">
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter
            Property="TextColor"
            Value="{StaticResource White}" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="Padding"
            Value="0,5" />
        <Setter
            Property="HeightRequest"
            Value="30" />
        <Setter
            Property="HorizontalTextAlignment"
            Value="Center" />
        <Setter
            Property="VerticalTextAlignment"
            Value="Center" />
    </Style>

    <!--   CARDS  -->
    <Style
        TargetType="Border"
        x:Key="Card">
        <Setter
            Property="Stroke"
            Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter
            Property="StrokeThickness"
            Value="1" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 20" />
        <Setter
            Property="Padding"
            Value="16" />
        <Setter
            Property="Shadow">
            <Setter.Value>
                <Shadow
                    Brush="{AppThemeBinding Light={StaticResource ShadowLight}, Dark={StaticResource ShadowDark}}"
                    Offset="0,4"
                    Radius="10"
                    Opacity="0.6" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        TargetType="Border"
        x:Key="CardFlat">
        <Setter
            Property="Stroke"
            Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter
            Property="StrokeThickness"
            Value="1" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 16" />
        <Setter
            Property="Padding"
            Value="16" />
    </Style>

    <Style
        TargetType="Border"
        x:Key="InputBorder">
        <Setter
            Property="Stroke"
            Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter
            Property="StrokeThickness"
            Value="1" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}" />
        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 14" />
        <Setter
            Property="Padding"
            Value="14,2" />
        <Setter
            Property="MinimumHeightRequest"
            Value="50" />
    </Style>

    <Style
        TargetType="Border"
        x:Key="Chip">
        <Setter
            Property="StrokeThickness"
            Value="0" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource PrimarySubtle}, Dark={StaticResource SurfaceVariantDark}}" />
        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 12" />
        <Setter
            Property="Padding"
            Value="10,4" />
    </Style>

    <Style
        TargetType="Border"
        x:Key="DataFrame">
        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 18" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource GlassLight}, Dark={StaticResource GlassDark}}" />
        <Setter
            Property="StrokeThickness"
            Value="0" />
        <Setter
            Property="Opacity"
            Value="0.7" />
    </Style>

    <Style
        TargetType="Border"
        x:Key="WhiteCardFrame">
        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 24" />
        <Setter
            Property="Stroke"
            Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter
            Property="StrokeThickness"
            Value="1" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter
            Property="Padding"
            Value="16" />
        <Setter
            Property="Margin"
            Value="0" />
    </Style>

    <Style
        TargetType="Border"
        x:Key="PopupBorder">
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter
            Property="Stroke"
            Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter
            Property="StrokeThickness"
            Value="1" />
        <Setter
            Property="StrokeShape"
            Value="RoundRectangle 24" />
        <Setter
            Property="Padding"
            Value="20" />
    </Style>

    <!--  BUTTONS   -->
    <Style
        TargetType="Button"
        x:Key="SecondaryButton">
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
        <Setter
            Property="BorderColor"
            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
        <Setter
            Property="BorderWidth"
            Value="1.5" />
        <Setter
            Property="CornerRadius"
            Value="24" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="Padding"
            Value="18,12" />
        <Setter
            Property="Opacity"
            Value="0.8" />
        <Setter
            Property="MinimumHeightRequest"
            Value="48" />
    </Style>

    <Style
        TargetType="Button"
        x:Key="GhostButton">
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
        <Setter
            Property="TextColor"
            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
        <Setter
            Property="BorderWidth"
            Value="0" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="Padding"
            Value="12,10" />
        <Setter
            Property="MinimumHeightRequest"
            Value="44" />
    </Style>

    <Style
        TargetType="Button"
        x:Key="DangerButton">
        <Setter
            Property="BackgroundColor"
            Value="{StaticResource Error}" />
        <Setter
            Property="TextColor"
            Value="{StaticResource White}" />
        <Setter
            Property="CornerRadius"
            Value="24" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="Padding"
            Value="18,12" />
        <Setter
            Property="MinimumHeightRequest"
            Value="48" />
    </Style>

    <Style
        TargetType="Button"
        x:Key="PillButton">
        <Setter
            Property="CornerRadius"
            Value="30" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="Padding"
            Value="16,10" />
        <Setter
            Property="MinimumHeightRequest"
            Value="44" />
    </Style>

    <Style
        TargetType="Button"
        x:Key="PopupMenuButton">
        <Setter
            Property="CornerRadius"
            Value="20" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter
            Property="TextColor"
            Value="{StaticResource White}" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="Padding"
            Value="18,12" />
        <Setter
            Property="MinimumHeightRequest"
            Value="46" />
        <Setter
            Property="Opacity"
            Value="0.9" />
    </Style>

    <Style
        TargetType="ImageButton"
        x:Key="ActionButton">
        <Setter
            Property="HorizontalOptions"
            Value="Center" />
        <Setter
            Property="VerticalOptions"
            Value="Center" />
        <Setter
            Property="BackgroundColor"
            Value="Transparent" />
        <Setter
            Property="HeightRequest"
            Value="30" />
        <Setter
            Property="WidthRequest"
            Value="30" />
        <Setter
            Property="Opacity"
            Value="0.8" />
    </Style>

    <Style
        TargetType="ImageButton"
        x:Key="FABButton">
        <Setter
            Property="HorizontalOptions"
            Value="Center" />
        <Setter
            Property="VerticalOptions"
            Value="Center" />
        <Setter
            Property="CornerRadius"
            Value="28" />
        <Setter
            Property="HeightRequest"
            Value="56" />
        <Setter
            Property="WidthRequest"
            Value="56" />
        <Setter
            Property="Padding"
            Value="5" />
        <Setter
            Property="Shadow">
            <Setter.Value>
                <Shadow
                    Brush="Black"
                    Offset="0,4"
                    Radius="10"
                    Opacity="0.25" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        TargetType="Button"
        x:Key="PrimaryButton">
        <Setter
            Property="TextColor"
            Value="{StaticResource White}" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="BorderWidth"
            Value="0" />
        <Setter
            Property="CornerRadius"
            Value="24" />
        <Setter
            Property="Opacity"
            Value="0.8" />
        <Setter
            Property="Padding"
            Value="18,12" />
        <Setter
            Property="MinimumHeightRequest"
            Value="48" />
        <Setter
            Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup
                    x:Name="CommonStates">
                    <VisualState
                        x:Name="Normal" />
                    <VisualState
                        x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter
                                Property="BackgroundColor"
                                Value="{StaticResource PrimaryDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState
                        x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter
                                Property="TextColor"
                                Value="{StaticResource White}" />
                            <Setter
                                Property="BackgroundColor"
                                Value="{StaticResource Gray300}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style
        TargetType="Button"
        x:Key="MenuActionButton">
        <Setter
            Property="CornerRadius"
            Value="20" />
        <Setter
            Property="BackgroundColor"
            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter
            Property="TextColor"
            Value="{StaticResource White}" />
        <Setter
            Property="FontAttributes"
            Value="Bold" />
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="Padding"
            Value="18,12" />
        <Setter
            Property="MinimumHeightRequest"
            Value="46" />
        <Setter
            Property="Opacity"
            Value="0.65" />
    </Style>
</ResourceDictionary>