<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Pages.RegistrationPage"
    x:DataType="vm:RegistrationViewModel">

    <VerticalStackLayout
        Padding="30,20"
        Spacing="15">

        <Label
            Text="Регистрация пользователя"
            Style="{StaticResource TitleLabel}" />

        <Entry
            x:Name="NameEntry"
            Placeholder="Имя"
            Text="{Binding Name, Mode=TwoWay}" />
        <Label
            x:Name="NameErrorLabel"
            Text="Допустимы только буквы!"
            Style="{StaticResource ErrorLabel}"
            IsVisible="{Binding NameErrorVisible}" />

        <Entry
            x:Name="EmailEntry"
            Placeholder="Email"
            Text="{Binding Email, Mode=TwoWay}" />
        <Label
            x:Name="LoginErrorLabel"
            Text="Неверный формат почты."
            Margin="5,-12,0,0"
            Style="{StaticResource ErrorLabel}"
            IsVisible="{Binding EmailErrorVisible}" />

        <Grid>

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Пароль"
                IsPassword="{Binding IsPasswordReadable, Converter={toolkit:InvertedBoolConverter}}"
                Text="{Binding Password, Mode=TwoWay}" />
            <ImageButton
                x:Name="ShowPasswordButton"
                Source="{Binding EyeIcon}"
                WidthRequest="30"
                Padding="10"
                Margin="0,0,-5,0"
                HorizontalOptions="End"
                Command="{Binding TogglePasswordVisibilityCommand}"
                BackgroundColor="Transparent" />
        </Grid>
        <Label
            x:Name="PasswordCheckErrorLabel"
            Text="Пароль должен содержать минимум 8 символов, хотя бы одну букву и одну цифру, и не содержать кириллицу!"
            Style="{StaticResource ErrorLabel}"
            IsVisible="{Binding PasswordErrorVisible}" />

        <Grid>
            <Entry
                x:Name="CheckPasswordEntry"
                Placeholder="Повторите пароль"
                IsPassword="{Binding IsCheckPasswordReadable, Converter={toolkit:InvertedBoolConverter}}"
                Text="{Binding CheckPassword, Mode=TwoWay}" />
            <ImageButton
                x:Name="ShowCheckPasswordButton"
                Source="{Binding CheckEyeIcon}"
                Command="{Binding ToggleCheckPasswordVisibilityCommand}"
                HeightRequest="30"
                WidthRequest="30"
                Padding="10"
                Margin="0,0,-5,0"
                HorizontalOptions="End"
                BackgroundColor="Transparent" />
        </Grid>
        <Label
            x:Name="PasswordErrorLabel"
            Text="Пароли не совпадают"
            Style="{StaticResource ErrorLabel}"
            IsVisible="{Binding CheckPasswordErrorVisible}" />

        <Grid
            ColumnSpacing="5"
            ColumnDefinitions="3*,2*">

            <Label
                Text=" Выберите дату рождения:"
                FontSize="14"
                Grid.Column="0"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Start" />
            <DatePicker
                x:Name="BirthDatePicker"
                Grid.Column="1"
                HorizontalOptions="Center"
                Date="{Binding BirthDate, Mode=TwoWay}"
                MinimumDate="{Binding MinDate}"
                MaximumDate="{Binding MaxDate}" />
        </Grid>
        <Picker
            x:Name="GenderPicker"
            Title="Выберите пол"
            SelectedItem="{Binding Gender, Mode=TwoWay}"
            ItemsSource="{Binding Genders}" />

        <Button
            Text="Продолжить"
            Command="{Binding ContinueCommand}"
            CornerRadius="30"
            Opacity="0.8" />
        <Label
            IsVisible="{Binding ExistingEmailErrorVisible}"
            HorizontalTextAlignment="Center"
            Text="Пользователь с заданной почтой уже существует"
            Style="{StaticResource ErrorLabel}" />
        <Label
            Text="Что-то пошло не так. Повторите попытку позже"
            IsVisible="{Binding ErrorMessageVisible}"
            HorizontalTextAlignment="Center"
            Style="{StaticResource ErrorLabel}" />
    </VerticalStackLayout>
</ContentPage>