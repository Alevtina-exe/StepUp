<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StepUp.Domain.Entities;assembly=StepUp.Domain"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Pages.SearchProductPage"
    x:DataType="vm:SearchProductViewModel">

    <Grid
        Padding="16"
        RowDefinitions="Auto, *"
        RowSpacing="16">

        <Grid
            ColumnDefinitions="Auto, *, Auto"
            ColumnSpacing="8">
            <Border
                Style="{StaticResource InputBorder}"
                Grid.Column="1">
                <Entry
                    Margin="0,3,0,0"
                    x:Name="SearchEntry"
                    Text="{Binding Query}"
                    VerticalTextAlignment="Center"
                    Placeholder="Название или штрих-код" />
            </Border>
            <ImageButton
                Command="{Binding SearchCommand}"
                Source="search_button.png"
                Style="{StaticResource FABButton}"
                Grid.Column="2" />
            <ImageButton
                Command="{Binding GoToBarcodeScannerCommand}"
                Source="barcode_scanner.png"
                Style="{StaticResource FABButton}"
                Grid.Column="0" />
        </Grid>

        <CollectionView
            ItemsSource="{Binding Products}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            Grid.Row="1"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate
                    x:DataType="models:FoodProduct">
                    <Border
                        Style="{StaticResource CardFlat}"
                        Padding="16,15">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchProductViewModel}}, Path=GoToAddProductCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="12">
                            <Label
                                Text="{Binding Name}"
                                FontSize="16"
                                FontAttributes="Bold"
                                Grid.Column="0"
                                LineBreakMode="TailTruncation" />
                            <Label
                                Text="{Binding Brands}"
                                Margin="5,0,0,0"
                                FontAttributes="Italic"
                                FontSize="12"
                                Grid.Row="1"/>
                            <Border
                                Style="{StaticResource Chip}"
                                Opacity="0.7"
                                BackgroundColor="{Binding NutrientsPer100g.Calories, Converter={StaticResource CaloriesToColor}}"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                VerticalOptions="Center">
                                <Label
                                    Text="{Binding NutrientsPer100g.Calories, StringFormat='{0} ккал'}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource White}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            x:Name="SearchError"
            Text="Результаты не найдены"
            Style="{StaticResource CaptionLabel}"
            FontSize="16"
            Grid.Row="1"
            HorizontalTextAlignment="Center"
            Margin="0,40,0,0"
            IsVisible="{Binding SearchErrorVisible}" />
    </Grid>
</ContentPage>