<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StepUp.Domain.Entities;assembly=StepUp.Domain"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Pages.SearchProductPage"
    x:DataType="vm:SearchFoodItemViewModel">
    
    <Grid
        Padding="10"
        RowDefinitions="Auto, *">
        <Grid
            ColumnDefinitions="*, Auto, Auto"
            Row="0"
            Margin="0,0,0,20">
            <Entry
                x:Name="SearchEntry"
                Text="{Binding Query}"
                Placeholder="Введите название или штрих-код"
                Grid.Column="0" />
            <ImageButton
                Command="{Binding SearchCommand}"
                Source="search_button.png"
                WidthRequest="40"
                HeightRequest="40"
                Grid.Column="1" />
            <ImageButton
                Command="{Binding GoToBarcodeScannerCommand}"
                Source="barcode_scanner.png"
                WidthRequest="40"
                HeightRequest="40"
                Grid.Column="2" />
        </Grid>
        <CollectionView
            ItemsSource="{Binding Products}"
            Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate
                    x:DataType="models:FoodProduct">
                    <Border
                        HeightRequest="80">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource 
                                AncestorType={x:Type vm:SearchFoodItemViewModel}}, 
                                Path=GoToAddProductCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="*,*"
                            Padding="20"
                            HeightRequest="100">
                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                VerticalTextAlignment="Center"
                                FontAttributes="Bold"
                                Grid.Column="0" />
                            <Label
                                Text="{Binding NutrientsPer100g.Calories}"
                                FontSize="20"
                                HorizontalTextAlignment="End"
                                TextColor="Gray"
                                Grid.Column="1"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!-- 
        <Label
            x:Name="favDishes"
            Grid.Row="1"
            Opacity="0.8"
            Text="Или выберите продукт из списка избранных"
            TextColor="{StaticResource Primary}"
            FontSize="24"
            HorizontalTextAlignment="Center"
            VerticalOptions="Start"
            HorizontalOptions="Center"
            Padding="20,0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="TapGestureRecognizer_Tapped" />
            </Label.GestureRecognizers>
        </Label> -->
        <Label
            x:Name="SearchError"
            Text="Результаты не найдены"
            FontSize="22"
            Grid.Row="1"
            HorizontalTextAlignment="Center"
            Margin="0,30,10,0"
            IsVisible="{Binding SearchErrorVisible}" /> 
    </Grid>
</ContentPage>