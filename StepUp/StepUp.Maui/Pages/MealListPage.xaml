<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StepUp.Domain.Entities;assembly=StepUp.Domain"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Pages.MealListPage"
    x:DataType="vm:MealListViewModel">
    <ScrollView>
        <Grid
            ColumnDefinitions="*,Auto">
            <Label
                Style="{StaticResource Header}"
                Text="{Binding MealName}" />
            <CollectionView
                ItemsSource="{Binding Dishes}" >
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="models:FoodItem">
                        <Border HeightRequest="80">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, Path=EditFoodItemCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid
                                ColumnDefinitions="*,Auto"
                                Padding="30,50,20,50"
                                HeightRequest="160">
                                <Label
                                    Text="{Binding Name}"
                                    FontSize="20"
                                    VerticalTextAlignment="Center"
                                    FontAttributes="Bold"
                                    Grid.Column="0" />
                                <Label
                                    Text="{Binding TotalNutrients.Calories, StringFormat='{0} ккал'}"
                                    FontSize="20"
                                    HorizontalTextAlignment="End"
                                    TextColor="Gray"
                                    Grid.Column="1"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ScrollView>
</ContentPage>