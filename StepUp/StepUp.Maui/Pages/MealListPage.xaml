<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:StepUp.Domain.Entities;assembly=StepUp.Domain"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Pages.MealListPage"
    x:DataType="vm:MealListViewModel">

    <Grid
        Padding="16"
        RowDefinitions="Auto, *"
        RowSpacing="20">

        <Grid
            ColumnDefinitions="*, Auto"
            ColumnSpacing="8"
            Padding="10,0">
            <Label
                Style="{StaticResource Header}"
                Text="{Binding MealName}"
                VerticalTextAlignment="Center"
                Grid.Column="0" />
            <Border
                Grid.Column="1"
                StrokeThickness="0"
                HeightRequest="40"
                WidthRequest="40"
                StrokeShape="RoundRectangle 30">

                <ImageButton
                    Margin="-5"
                    Command="{Binding GoToAddProductCommand}"
                    Source="{StaticResource IconRoundAdd}" />
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.25" />
                </Border.Shadow>
            </Border>
        </Grid>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Dishes}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate
                    x:DataType="models:FoodItem">
                    <Border
                        Style="{StaticResource CardFlat}"
                        Padding="16,15">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource 
                                AncestorType={x:Type vm:MealListViewModel}}, 
                                Path=EditFoodItemCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                            <Label
                                Text="{Binding Name}"
                                FontSize="16"
                                FontAttributes="Bold"
                                VerticalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                Grid.Column="0" />
                            <Border
                                Style="{StaticResource Chip}"
                                Opacity="0.7"
                                BackgroundColor="{Binding TotalNutrients.Calories,
                                Converter={StaticResource CaloriesToColor}}"
                                Grid.Column="1"
                                VerticalOptions="Center">
                                <Label
                                    Text="{Binding TotalNutrients.Calories, 
                                    StringFormat='{0} ккал'}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource White}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            Grid.Row="1"
            Text="{Binding MealName, StringFormat='{0} пока не добавлен. Нажмите +, чтобы добавить.'}"
            Style="{StaticResource CaptionLabel}"
            FontSize="16"
            HorizontalTextAlignment="Center"
            Margin="0,40,0,0"
            IsVisible="{Binding IsMessageVisible}" />
    </Grid>
</ContentPage>