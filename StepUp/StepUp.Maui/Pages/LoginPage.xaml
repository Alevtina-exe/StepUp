<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Pages.LoginPage"
    x:DataType="vm:LoginViewModel">

    <VerticalStackLayout
        Padding="30,0,30,150"
        Spacing="15"
        VerticalOptions="Center">

        <Label
            Text="Вход в аккаунт:"
            Style="{StaticResource TitleLabel}" />

        <Entry
            x:Name="EmailEntry"
            Placeholder="Email"
            Text="{Binding Email, Mode=TwoWay}" />
        <Label
            x:Name="EmailErrorLabel"
            Text="Неверный формат почты."
            Style="{StaticResource ErrorLabel}"
            IsVisible="{Binding EmailErrorVisible}" />

        <Grid
            ColumnSpacing="5"
            ColumnDefinitions="*, 30">

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Пароль"
                IsPassword="{Binding IsPasswordReadable, Converter={toolkit:InvertedBoolConverter}}"
                Text="{Binding Password, Mode=TwoWay}"
                Grid.Column="0" />
            <ImageButton
                x:Name="ShowPasswordButton"
                Source="{Binding EyeIcon}"
                HeightRequest="30"
                Margin="2"
                VerticalOptions="Fill"
                HorizontalOptions="Center"
                Command="{Binding TogglePasswordVisibilityCommand}"
                BackgroundColor="Transparent"
                Grid.Column="1" />
        </Grid>

        <Button
            Text="Войти"
            Command="{Binding LoginCommand}"
            CornerRadius="40"
            HorizontalOptions="Fill" />

        <Label
            Text="Нет аккаунта? Создать новый"
            TextColor="{StaticResource TextSecondary}"
            HorizontalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding GoToRegisterPageCommand}" />
            </Label.GestureRecognizers>
        </Label>

        <Label
            IsVisible="{Binding NotExistingEmailErrorVisible}"
            HorizontalTextAlignment="Center"
            Text="Пользователя с заданной почтой не существует"
            Style="{StaticResource ErrorLabel}" />
        <Label
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding ErrorMessageVisible}"
            HorizontalTextAlignment="Center"
            Style="{StaticResource ErrorLabel}" />
    </VerticalStackLayout>
</ContentPage>