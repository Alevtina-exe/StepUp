<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Pages.LoginPage"
    x:DataType="vm:LoginViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,40,30,40"
            Spacing="20"
            VerticalOptions="Center">

            <VerticalStackLayout
                Spacing="6"
                Margin="0,0,0,24">
                <Label
                    Text="StepUp"
                    Style="{StaticResource TitleLabel}"
                    FontSize="34"
                    TextColor="{StaticResource Primary}" />
                <Label
                    Text="С возвращением 👋"
                    Style="{StaticResource SectionLabel}"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Войдите, чтобы продолжить"
                    Style="{StaticResource CaptionLabel}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="6">
                <Label
                    Text="Email"
                    Style="{StaticResource SectionLabel}" />
                <Border
                    Style="{StaticResource InputBorder}">
                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="you@example.com"
                        Keyboard="Email"
                        Text="{Binding Email, Mode=TwoWay}" />
                </Border>
                <Label
                    x:Name="EmailErrorLabel"
                    Text="Неверный формат почты."
                    Style="{StaticResource ErrorLabel}"
                    IsVisible="{Binding EmailErrorVisible}" />
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout
                Spacing="6">
                <Label
                    Text="Пароль"
                    Style="{StaticResource SectionLabel}" />
                <Border
                    Style="{StaticResource InputBorder}"
                    Padding="14,2,4,2">
                    <Grid
                        ColumnDefinitions="*,Auto">
                        <Entry
                            x:Name="PasswordEntry"
                            Placeholder="••••••••"
                            IsPassword="{Binding IsPasswordReadable, Converter={toolkit:InvertedBoolConverter}}"
                            Text="{Binding Password, Mode=TwoWay}"
                            Grid.Column="0" />
                        <ImageButton
                            x:Name="ShowPasswordButton"
                            Source="{Binding EyeIcon}"
                            HeightRequest="36"
                            WidthRequest="36"
                            Padding="6"
                            Margin="0,0,4,0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            BackgroundColor="Transparent"
                            Grid.Column="1" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Button
                Text="Войти"
                Command="{Binding LoginCommand}"
                Style="{StaticResource PrimaryButton}"
                Margin="0,12,0,0" />

            <Label
                IsVisible="{Binding NotExistingEmailErrorVisible}"
                HorizontalTextAlignment="Center"
                Text="Пользователя с заданной почтой не существует"
                Style="{StaticResource ErrorLabel}" />
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding ErrorMessageVisible}"
                HorizontalTextAlignment="Center"
                Style="{StaticResource ErrorLabel}" />

            <Border
                Style="{StaticResource Chip}"
                HorizontalOptions="Center"
                Margin="0,16,0,0"
                Padding="14,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding GoToRegisterPageCommand}" />
                </Border.GestureRecognizers>
                <Label
                    Text="Нет аккаунта? Создать новый"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>