<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Pages.BodyDataPage"
    x:DataType="vm:BodyDataViewModel">

    <Grid
        RowDefinitions="*">
        <VerticalStackLayout
            Padding="30"
            Spacing="10">
            <Label
                Text="Введите данные"
                Style="{StaticResource SubtitleLabel}" />

            <Entry
                Placeholder="Вес"
                Keyboard="Numeric"
                Text="{Binding WeightInput, Mode=TwoWay}" />
            <Entry
                Placeholder="Рост"
                Keyboard="Numeric"
                Text="{Binding HeightInput, Mode=TwoWay}" />

            <Label
                Text="Ваш ИМТ:"
                FontSize="22"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding BmiResult.Value, StringFormat='ИМТ: {0:F1}'}"
                IsVisible="{Binding IsFormValid}"
                HorizontalOptions="Center" />

            <Grid
                x:Name="MyGrid"
                ColumnSpacing="0"
                HeightRequest="20"
                ColumnDefinitions="10*,6*,5*,5*,5*,4*">
                <BoxView
                    BackgroundColor="{StaticResource BmiDeficit}"
                    Grid.Column="0"
                    Opacity="0.8" />
                <BoxView
                    BackgroundColor="{StaticResource BmiNormal}"
                    Grid.Column="1"
                    Opacity="0.8" />
                <BoxView
                    BackgroundColor="{StaticResource BmiOverweight}"
                    Grid.Column="2"
                    Opacity="0.8" />
                <BoxView
                    BackgroundColor="{StaticResource BmiObese1}"
                    Grid.Column="3"
                    Opacity="0.8" />
                <BoxView
                    BackgroundColor="{StaticResource BmiObese2}"
                    Grid.Column="4"
                    Opacity="0.8" />
                <BoxView
                    BackgroundColor="{StaticResource BmiObese3}"
                    Grid.Column="5"
                    Opacity="0.8" />

                <BoxView
                    x:Name="IMTIndicator"
                    BackgroundColor="DarkSlateGray"
                    WidthRequest="2"
                    HeightRequest="22"
                    IsVisible="{Binding IsFormValid}"
                    HorizontalOptions="Start"
                    Grid.Column="0" />
            </Grid>

            <Label
                Text="{Binding BmiCategoryText}"
                FontSize="20"
                HorizontalOptions="Center" />

            <Picker
                Title="Выберите физ. нагрузку"
                ItemsSource="{Binding SportLevels}"
                SelectedItem="{Binding SelectedSportLevel, Mode=TwoWay}"
                ItemDisplayBinding="{Binding DisplayName}" />

            <VerticalStackLayout
                IsVisible="{Binding IsStepTwo}"
                Spacing="10">
                <Label
                    Text="Рекомендованное КБЖУ: "
                    FontSize="22"
                    HorizontalOptions="Center" />

                <AbsoluteLayout
                    HorizontalOptions="Center"
                    HeightRequest="110">
                    <Label
                        Text="{Binding CaloriePlan}"
                        FontSize="50"
                        AbsoluteLayout.LayoutBounds="0,-5,1,1"
                        AbsoluteLayout.LayoutFlags="SizeProportional"
                        FontFamily="impact"
                        HorizontalTextAlignment="Center"
                        TextColor="SandyBrown">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding EditCaloriesCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        Text="ккал"
                        TextColor="SandyBrown"
                        FontSize="30"
                        FontFamily="impact"
                        AbsoluteLayout.LayoutBounds="0,50,1,35"
                        AbsoluteLayout.LayoutFlags="WidthProportional"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="вы можете изменить калораж нажав на него"
                        FontSize="12"
                        TextColor="Gray"
                        AbsoluteLayout.LayoutBounds="0,92,1,15"
                        AbsoluteLayout.LayoutFlags="WidthProportional"
                        HorizontalTextAlignment="Center" />
                </AbsoluteLayout>

                <Grid
                    ColumnSpacing="5"
                    HorizontalOptions="Center"
                    ColumnDefinitions="*,40,*"
                    RowDefinitions="Auto,Auto,Auto">
                    <Label
                        Text="белки:"
                        Grid.Column="0"
                        Grid.Row="0"
                        HorizontalTextAlignment="End"
                        VerticalTextAlignment="Center" />
                    <Entry
                        Text="{Binding ProteinInput, Mode=TwoWay}"
                        Grid.Row="0"
                        Grid.Column="1"
                        Keyboard="Numeric"
                        HorizontalTextAlignment="Center"
                        TextColor="{Binding IsPfcValid, Converter={StaticResource BoolToGreenRed}}" />
                    <Label
                        Text="%"
                        Grid.Column="2"
                        Grid.Row="0"
                        VerticalTextAlignment="Center" />

                    <Label
                        Text="жиры:"
                        Grid.Column="0"
                        Grid.Row="1"
                        HorizontalTextAlignment="End"
                        VerticalTextAlignment="Center" />
                    <Entry
                        Text="{Binding FatInput, Mode=TwoWay}"
                        Grid.Column="1"
                        Grid.Row="1"
                        Keyboard="Numeric"
                        HorizontalTextAlignment="Center"
                        TextColor="{Binding IsPfcValid, Converter={StaticResource BoolToGreenRed}}" />
                    <Label
                        Text="%"
                        Grid.Column="2"
                        Grid.Row="1"
                        VerticalTextAlignment="Center" />

                    <Label
                        Text="углеводы:"
                        Grid.Column="0"
                        Grid.Row="2"
                        HorizontalTextAlignment="End"
                        VerticalTextAlignment="Center" />
                    <Entry
                        Text="{Binding CarbonInput, Mode=TwoWay}"
                        Grid.Column="1"
                        Grid.Row="2"
                        Keyboard="Numeric"
                        HorizontalTextAlignment="Center"
                        TextColor="{Binding IsPfcValid, Converter={StaticResource BoolToGreenRed}}" />
                    <Label
                        Text="%"
                        Grid.Column="2"
                        Grid.Row="2"
                        VerticalTextAlignment="Center" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout
            VerticalOptions="End"
            Spacing="5"
            Padding="30,0,30,10">
            <Button
                Text="Продолжить"
                Command="{Binding ContinueCommand}"
                CornerRadius="30"
                Opacity="0.8" />
            <Button
                Text="Назад"
                Command="{Binding BackCommand}"
                CornerRadius="30"
                Opacity="0.8" />
            <Label
                Text="Что-то пошло не так. Проверьте соединение"
                IsVisible="{Binding ErrorMessageVisible}"
                TextColor="Red"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>