<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    xmlns:enums="clr-namespace:StepUp.Domain.Enums;assembly=StepUp.Domain"
    x:Class="StepUp.Maui.Pages.MainPage"
    x:DataType="vm:MainViewModel">
    <Grid>
        <ScrollView>
            <Grid
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                Padding="0,0,0,90"
                RowSpacing="5"
                Background="{StaticResource MainPageGradient}">

                <HorizontalStackLayout
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    Spacing="6"
                    Margin="0,16,0,0">
                    <ImageButton
                        Source="calendar.png"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="6"
                        CornerRadius="18"
                        Clicked="DateButtonClicked" />
                    <Label
                        x:Name="DateLabel"
                        VerticalTextAlignment="Center"
                        FontSize="20"
                        FontAttributes="Bold"
                        Text="{Binding DateString}"
                        TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="DateButtonTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <DatePicker
                        x:Name="datePicker"
                        IsVisible="False"
                        Format="dd.MM.yyyy"
                        MaximumDate="{Binding MaxDate}"
                        MinimumDate="{Binding MinDate}"
                        Date="{Binding Date}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="20,0"
                    HorizontalOptions="Center"
                    Spacing="10">

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        Spacing="2"
                        Margin="0,0,4,0"
                        WidthRequest="80">
                        <Label
                            x:Name="KcalEatenLabel"
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"
                            FontSize="26"
                            TextColor="White" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="потреблено"
                            FontSize="12"
                            TextColor="#E0D6FA" />
                    </VerticalStackLayout>

                    <Grid
                        WidthRequest="160"
                        HeightRequest="160">
                        <Ellipse
                            WidthRequest="160"
                            HeightRequest="160"
                            Stroke="#40FFFFFF"
                            StrokeThickness="16" />
                        <Path
                            x:Name="progressBar"
                            WidthRequest="160"
                            HeightRequest="160"
                            StrokeThickness="16"
                            Fill="Transparent">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure
                                        StartPoint="80,8">
                                        <ArcSegment
                                            x:Name="Arc"
                                            Size="72,72" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="0">
                            <Label
                                x:Name="KcalResLabel"
                                HorizontalTextAlignment="Center"
                                FontSize="36"
                                FontAttributes="Bold" />
                            <Label
                                x:Name="KcalLeft"
                                HorizontalTextAlignment="Center"
                                FontSize="13"
                                Text="ккал осталось"
                                TextColor="#E0D6FA" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        Spacing="2"
                        WidthRequest="80">
                        <Label
                            x:Name="KcalBurntLabel"
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"
                            FontSize="26"
                            TextColor="White">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding GoToSportsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="сожжено"
                            FontSize="12"
                            TextColor="#E0D6FA" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border
                    Grid.Row="2"
                    Margin="20,30,20,10"
                    Padding="14,10"
                    Style="{StaticResource DataFrame}">
                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="8"
                        HeightRequest="80">
                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="4"
                            VerticalOptions="Center">
                            <Label
                                Text="Белки"
                                HorizontalOptions="Center"
                                Style="{StaticResource SectionLabel}" />
                            <Border
                                StrokeThickness="0"
                                MaximumHeightRequest="10">
                                <ProgressBar
                                    Progress="{Binding PrProgressBar}"
                                    ProgressColor="{Binding PrProgressBar,
                                    Converter={StaticResource MacroRatioToColor}}"
                                    ScaleY="2"
                                    Margin="0,-2"/>
                            </Border>
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource CaptionLabel}"
                                Text="{Binding ProteinString}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4"
                            VerticalOptions="Center">
                            <Label
                                Text="Жиры"
                                HorizontalOptions="Center"
                                Style="{StaticResource SectionLabel}" />
                            <Border
                                StrokeThickness="0"
                                MaximumHeightRequest="10">
                                <ProgressBar
                                    Progress="{Binding FatProgressBar}"
                                    ProgressColor="{Binding FatProgressBar,
                                    Converter={StaticResource MacroRatioToColor}}"
                                    ScaleY="2" />
                            </Border>
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource CaptionLabel}"
                                Text="{Binding FatString}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout
                            Grid.Column="2"
                            Spacing="4"
                            VerticalOptions="Center">
                            <Label
                                Text="Углеводы"
                                HorizontalOptions="Center"
                                Style="{StaticResource SectionLabel}" />
                            <Border
                                StrokeThickness="0"
                                MaximumHeightRequest="10">
                                <ProgressBar
                                    Progress="{Binding CbProgressBar}"
                                    ProgressColor="{Binding CbProgressBar, 
                                    Converter={StaticResource MacroRatioToColor}}"
                                    ScaleY="2" />
                            </Border>
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource CaptionLabel}"
                                Text="{Binding CarbonString}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>


                <Border
                    Grid.Row="3"
                    Margin="15,10,15,4"
                    Style="{StaticResource DataFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToMealCommand}"
                            CommandParameter="{x:Static enums:MealType.Breakfast}" />
                    </Border.GestureRecognizers>
                    <StackLayout>
                        <Label
                            Style="{StaticResource PFCNameLabel}"
                            Text="ЗАВТРАК" />
                        <HorizontalStackLayout
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            HeightRequest="60"
                            Spacing="16">
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding BrKcal, StringFormat='{0} ккал'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding BrPr, StringFormat='Б: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding BrFat, StringFormat='Ж: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding BrCb, StringFormat='У: {0:F1} г'}" />
                        </HorizontalStackLayout>
                    </StackLayout>
                </Border>

                <Border
                    Grid.Row="4"
                    Margin="15,4"
                    Style="{StaticResource DataFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToMealCommand}"
                            CommandParameter="{x:Static enums:MealType.Lunch}" />
                    </Border.GestureRecognizers>
                    <StackLayout>
                        <Label
                            Style="{StaticResource PFCNameLabel}"
                            Text="ОБЕД" />
                        <HorizontalStackLayout
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            HeightRequest="60"
                            Spacing="16">
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding LnKcal, StringFormat='{0} ккал'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding LnPr, StringFormat='Б: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding LnFat, StringFormat='Ж: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding LnCb, StringFormat='У: {0:F1} г'}" />
                        </HorizontalStackLayout>
                    </StackLayout>
                </Border>

                <Border
                    Grid.Row="5"
                    Margin="15,4"
                    Style="{StaticResource DataFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToMealCommand}"
                            CommandParameter="{x:Static enums:MealType.Dinner}" />
                    </Border.GestureRecognizers>
                    <StackLayout>
                        <Label
                            Style="{StaticResource PFCNameLabel}"
                            Text="УЖИН" />
                        <HorizontalStackLayout
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            HeightRequest="60"
                            Spacing="16">
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding DnKcal, StringFormat='{0} ккал'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding DnPr, StringFormat='Б: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding DnFat, StringFormat='Ж: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding DnCb, StringFormat='У: {0:F1} г'}" />
                        </HorizontalStackLayout>
                    </StackLayout>
                </Border>

                <Border
                    Grid.Row="6"
                    Margin="15,4,15,20"
                    Style="{StaticResource DataFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToMealCommand}"
                            CommandParameter="{x:Static enums:MealType.Snack}" />
                    </Border.GestureRecognizers>
                    <StackLayout>
                        <Label
                            Style="{StaticResource PFCNameLabel}"
                            Text="ПЕРЕКУС" />
                        <HorizontalStackLayout
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            HeightRequest="60"
                            Spacing="16">
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding SnKcal, StringFormat='{0} ккал'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding SnPr, StringFormat='Б: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding SnFat, StringFormat='Ж: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding SnCb, StringFormat='У: {0:F1} г'}" />
                        </HorizontalStackLayout>
                    </StackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <Border
            VerticalOptions="End"
            HorizontalOptions="Fill"
            Padding="14,10"
            Stroke="Transparent"
            Margin="20,0,20,10"
            BackgroundColor="{StaticResource GlassLight}"
            StrokeShape="RoundRectangle 28">
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Offset="0,4"
                    Radius="16"
                    Opacity="0.18" />
            </Border.Shadow>
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="0">
                <ImageButton
                    x:Name="GraphBtn"
                    Grid.Column="0"
                    Source="{StaticResource IconGraph}"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding GoToGraphCommand}" />
                <ImageButton
                    x:Name="AddBtn"
                    Grid.Column="1"
                    Source="{StaticResource IconAdd}"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding GoToMenuCommand}" />
                <ImageButton
                    x:Name="SettingsBtn"
                    Grid.Column="2"
                    Source="{StaticResource IconSetting}"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding GoToSettingsCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>