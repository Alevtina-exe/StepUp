<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StepUp.Presentation.ViewModels;assembly=StepUp.Presentation"
    xmlns:enums="clr-namespace:StepUp.Domain.Enums;assembly=StepUp.Domain"
    x:Class="StepUp.Maui.Pages.MainPage"
    x:DataType="vm:MainViewModel">
    <Grid
        RowDefinitions="*">
        <ScrollView>
            <Grid
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                RowSpacing="5"
                Background="{StaticResource MainPageGradient}">

                <StackLayout
                    Orientation="Horizontal"
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Spacing="5"
                    Margin="0,10,0,0">

                    <ImageButton
                        Source="calendar.png"
                        HorizontalOptions="Center"
                        WidthRequest="40"
                        HeightRequest="40"
                        Opacity="0.8"
                        Clicked="DateButtonClicked" />
                    <Label
                        x:Name="DateLabel"
                        VerticalTextAlignment="Center"
                        FontSize="22"
                        Text="{Binding DateString}"
                        TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="DateButtonTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <DatePicker
                        x:Name="datePicker"
                        WidthRequest="1"
                        HeightRequest="1"
                        Format="dd.MM.yyyy"
                        MaximumDate="{Binding MaxDate}"
                        MinimumDate="{Binding MinDate}"
                        Date="{Binding Date}" />
                </StackLayout>

                <StackLayout
                    Orientation="Horizontal"
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    Margin="0,15,0,0"
                    Spacing="10"
                    Padding="0">

                    <StackLayout
                        Orientation="Vertical"
                        VerticalOptions="Center"
                        Spacing="0"
                        Margin="0,20,0,0">

                        <Label
                            x:Name="KcalEaten"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"
                            FontSize="26"
                            Text="{Binding KcalEaten}"
                            TextColor="White" />
                        <Label
                            HorizontalOptions="Center"
                            Text="потребление"
                            TextColor="White" />
                    </StackLayout>

                    <StackLayout
                        Orientation="Vertical"
                        Margin="0,50,0,0"
                        Spacing="5">

                        <Grid
                            HorizontalOptions="Center">
                            <Ellipse
                                WidthRequest="150"
                                HeightRequest="150"
                                Stroke="LightGray"
                                StrokeThickness="16" />

                            <Path
                                x:Name="progressBar"
                                WidthRequest="150"
                                HeightRequest="150"
                                Fill="Transparent"
                                StrokeThickness="16"
                                Stroke="Green">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure
                                            StartPoint="0,67">
                                            <ArcSegment
                                                x:Name="Arc"
                                                Point="0,67"
                                                Size="67,67"
                                                IsLargeArc="False"
                                                SweepDirection="Clockwise" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Label
                                x:Name="KcalResLabel"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                HorizontalTextAlignment="Center"
                                FontSize="36"
                                FontAttributes="Bold" />
                        </Grid>
                        <Label
                            x:Name="KcalLeft"
                            Grid.Row="2"
                            HorizontalOptions="Center"
                            FontSize="24"
                            Text="ккал осталось"
                            TextColor="White" />
                    </StackLayout>

                    <StackLayout
                        Orientation="Vertical"
                        VerticalOptions="Center"
                        Spacing="0"
                        Margin="0,20,0,0">
                        <Label
                            x:Name="KcalSpent"
                            HorizontalOptions="Center"
                            WidthRequest="88.8"
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"
                            FontSize="26"
                            Text="{Binding KcalBurnt}"
                            TextColor="White">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding GoToSportsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            HorizontalOptions="Center"
                            WidthRequest="88.8"
                            HorizontalTextAlignment="Center"
                            Text="расход"
                            TextColor="White" />
                    </StackLayout>
                </StackLayout>

                <Border
                    Grid.Row="1"
                    VerticalOptions="Center"
                    Margin="20,30,20,15"
                    Padding="10,5"
                    Style="{StaticResource DataFrame}">
                    <Grid
                        ColumnDefinitions="*,*,*"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        HeightRequest="80">
                        <StackLayout
                            Orientation="Vertical"
                            Grid.Column="0"
                            VerticalOptions="Center">
                            <Label
                                Text="белки"
                                HorizontalOptions="Center"
                                VerticalTextAlignment="Center"
                                FontSize="16"
                                FontAttributes="Bold" />
                            <ProgressBar
                                Progress="{Binding PrProgress}"
                                Margin="10,0"
                                ProgressColor="{Binding PrProgress, Converter={StaticResource MacroRatioToColor}}" />
                            <Label
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                FontSize="12"
                                Text="{Binding ProteinString}" />
                        </StackLayout>

                        <StackLayout
                            Orientation="Vertical"
                            Grid.Column="1"
                            VerticalOptions="Center">
                            <Label
                                Text="жиры"
                                HorizontalOptions="Center"
                                VerticalTextAlignment="Center"
                                FontSize="16"
                                FontAttributes="Bold" />
                            <ProgressBar
                                Progress="{Binding FatProgress}"
                                Margin="10,0"
                                ProgressColor="{Binding FatProgress, Converter={StaticResource MacroRatioToColor}}" />
                            <Label
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                FontSize="12"
                                Text="{Binding FatString}" />
                        </StackLayout>

                        <StackLayout
                            Orientation="Vertical"
                            Grid.Column="2"
                            VerticalOptions="Center">
                            <Label
                                Text="углеводы"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                FontSize="16"
                                FontAttributes="Bold" />
                            <ProgressBar
                                Progress="{Binding CbProgress}"
                                Margin="10,0"
                                ProgressColor="{Binding CbProgress, Converter={StaticResource MacroRatioToColor}}" />
                            <Label
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                FontSize="12"
                                Text="{Binding CarbonString}" />
                        </StackLayout>
                    </Grid>
                </Border>

                <!--<Border
                    Grid.Row="2"
                    VerticalOptions="Center"
                    HeightRequest="80"
                    Margin="20,5,20,10"
                    Padding="20,15,20,20"
                    StrokeShape="RoundRectangle 40"
                    Opacity="0.60"
                    BorderColor="{StaticResource PrimaryDarker}"
                    BackgroundColor="{StaticResource PrimaryDarker}"
                    IsVisible="{Binding StepCounterIsVisible}">
                    <Grid
                        ColumnDefinitions="Auto,*"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        HeightRequest="60">
                        <Image
                            Grid.Column="0"
                            WidthRequest="50"
                            HeightRequest="50"
                            Margin="0,5,0,0"
                            Source="steps.png" />
                        <StackLayout
                            Orientation="Vertical"
                            Grid.Column="1">
                            <Label
                                x:Name="StepLabel"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="End"
                                BindingContext="{Binding StepModelView}"
                                FontAttributes="Bold"
                                FontSize="28"
                                TextColor="White"
                                Text="{Binding StepsText}" />
                            <Label
                                x:Name="StepKcalLabel"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Start"
                                BindingContext="{Binding StepModelView}"
                                FontSize="18"
                                TextColor="LightGray"
                                Text="{Binding Calories}" />
                        </StackLayout>
                    </Grid>
                </Border>-->

                <Border
                    Grid.Row="3"
                    VerticalOptions="Center"
                    Margin="15,15,15,5"
                    Padding="0"
                    Style="{StaticResource DataFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToMealCommand}"
                            CommandParameter="{x:Static enums:MealType.Breakfast}" />
                    </Border.GestureRecognizers>
                    <StackLayout>
                        <Label
                            Style="{StaticResource PFCNameLabel}"
                            Text="Завтрак" />
                        <StackLayout
                            Orientation="Horizontal"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            HeightRequest="60"
                            Padding="0"
                            Spacing="16">
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding BrKcal, StringFormat='{0} ккал'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding BrPr, StringFormat='Б: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding BrFat, StringFormat='Ж: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding BrCb, StringFormat='У: {0:F1} г'}" />
                        </StackLayout>
                    </StackLayout>
                </Border>

                <Border
                    Grid.Row="4"
                    VerticalOptions="Center"
                    Margin="15,5"
                    Padding="0"
                    Style="{StaticResource DataFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToMealCommand}"
                            CommandParameter="{x:Static enums:MealType.Lunch}" />
                    </Border.GestureRecognizers>
                    <StackLayout>
                        <Label
                            Style="{StaticResource PFCNameLabel}"
                            Text="Обед" />
                        <StackLayout
                            Orientation="Horizontal"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            HeightRequest="60"
                            Padding="0"
                            Spacing="16">
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding LnKcal, StringFormat='{0} ккал'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding LnPr, StringFormat='Б: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding LnFat, StringFormat='Ж: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding LnCb, StringFormat='У: {0:F1} г'}" />
                        </StackLayout>
                    </StackLayout>
                </Border>

                <Border
                    Grid.Row="5"
                    VerticalOptions="Center"
                    Margin="15,5"
                    Padding="0"
                    Style="{StaticResource DataFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToMealCommand}"
                            CommandParameter="{x:Static enums:MealType.Dinner}" />
                    </Border.GestureRecognizers>
                    <StackLayout>
                        <Label
                            Style="{StaticResource PFCNameLabel}"
                            Text="Ужин" />
                        <StackLayout
                            Orientation="Horizontal"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            HeightRequest="60"
                            Spacing="16"
                            Padding="0">
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding DnKcal, StringFormat='{0} ккал'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding DnPr, StringFormat='Б: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding DnFat, StringFormat='Ж: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding DnCb, StringFormat='У: {0:F1} г'}" />
                        </StackLayout>
                    </StackLayout>
                </Border>

                <Border
                    Grid.Row="6"
                    VerticalOptions="Center"
                    Margin="15,5,15,80"
                    Padding="0"
                    Style="{StaticResource DataFrame}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToMealCommand}"
                            CommandParameter="{x:Static enums:MealType.Snack}" />
                    </Border.GestureRecognizers>
                    <StackLayout>
                        <Label
                            Style="{StaticResource PFCNameLabel}"
                            Text="Перекус" />
                        <StackLayout
                            Orientation="Horizontal"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            HeightRequest="60"
                            Spacing="16"
                            Padding="0">
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding SnKcal, StringFormat='{0} ккал'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding SnPr, StringFormat='Б: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding SnFat, StringFormat='Ж: {0:F1} г'}" />
                            <Label
                                Style="{StaticResource PFCLabel}"
                                Text="{Binding SnCb, StringFormat='У: {0:F1} г'}" />
                        </StackLayout>
                    </StackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <Border
            VerticalOptions="End"
            HorizontalOptions="Fill"
            Padding="0"
            Stroke="Transparent"
            BackgroundColor="Transparent">
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="0"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                Padding="10">
                <Grid.Shadow>
                    <Shadow
                        Brush="Black"
                        Offset="5,5"
                        Radius="10"
                        Opacity="0.5" />
                </Grid.Shadow>
                <ImageButton
                    x:Name="GraphBtn"
                    Grid.Column="0"
                    VerticalOptions="End"
                    Source="{StaticResource IconGraph}"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding GoToGraphCommand}" />
                <ImageButton
                    x:Name="AddBtn"
                    Grid.Column="1"
                    Source="{StaticResource IconAdd}"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding GoToMenuCommand}" />
                <ImageButton
                    x:Name="SettingsBtn"
                    Grid.Column="2"
                    VerticalOptions="End"
                    Source="{StaticResource IconSetting}"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding GoToSettingsCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>