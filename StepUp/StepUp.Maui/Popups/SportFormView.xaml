<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StepUp.Maui.Popups.SportFormView">

    <VerticalStackLayout
        Spacing="5">
        <Label
            x:Name="TitleLabel"
            FontSize="16"
            HorizontalTextAlignment="Center"
            TextColor="Black" />

        <Entry
            x:Name="NameEntry"
            Placeholder="Название"
            TextChanged="OnEntryChanged"
            PlaceholderColor="Black" />

        <Entry
            x:Name="KcalEntry"
            Placeholder="Количество калорий"
            Keyboard="Numeric"
            TextChanged="OnEntryChanged"
            PlaceholderColor="Black" />

        <Label
            x:Name="ErrorLabel"
            TextColor="{StaticResource ErrorColor}"
            HorizontalOptions="Center"
            IsVisible="False" />
        <Grid
            ColumnDefinitions="*,*,*"
            ColumnSpacing="5"
            HorizontalOptions="Center">

            <Button
                x:Name="CancelButton"
                Text="Отмена"
                Clicked="OnCancelClicked"
                Style="{StaticResource PopupMenuButton}"
                Grid.Column="0" />
            <Button
                x:Name="SaveButton"
                Text="OK"
                Clicked="OnSaveClicked"
                Style="{StaticResource PopupMenuButton}"
                Grid.Column="1" />

            <Button
                x:Name="DeleteButton"
                Text="Удалить"
                Clicked="OnDeleteClicked"
                Style="{StaticResource PopupMenuButton}"
                Grid.Column="2"
                IsVisible="False" />
        </Grid>
    </VerticalStackLayout>
</ContentView>