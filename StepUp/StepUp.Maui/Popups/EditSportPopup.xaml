<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:popups="clr-namespace:StepUp.Maui.Popups"
    xmlns:models="clr-namespace:StepUp.Presentation.Models;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Popups.EditSportPopup"
    x:TypeArguments="models:SportResult"
    BackgroundColor="Transparent">

    <Border
        Style="{StaticResource PopupBorder}" >
        <popups:SportFormView
            x:Name="FormView" />
    </Border>
</toolkit:Popup>