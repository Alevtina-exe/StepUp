<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:popups="clr-namespace:StepUp.Maui.Popups"
    x:Class="StepUp.Maui.Popups.ChangePasswordPopup"
    x:TypeArguments="system:String"
    x:DataType="popups:ChangePasswordPopup"
    BackgroundColor="Transparent">

    <Border
        Style="{StaticResource PopupBorder}">
        <VerticalStackLayout
            Spacing="12">
            <Label
                x:Name="TitleLabel"
                Text="Изменить пароль"
                Style="{StaticResource SubtitleLabel}" />

            <Border
                Style="{StaticResource InputBorder}">
                <Entry
                    x:Name="Password"
                    Placeholder="Введите новый пароль"
                    TextChanged="OnEntryChanged" />
            </Border>

            <Label
                x:Name="ErrorLabel"
                IsVisible="False"
                Style="{StaticResource ErrorLabel}"
                HorizontalOptions="Center" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="8">
                <Button
                    x:Name="SaveButton"
                    Text="OK"
                    IsEnabled="False"
                    Clicked="OnSaveClicked"
                    Style="{StaticResource PrimaryButton}"
                    Grid.Column="0" />
                <Button
                    x:Name="CancelButton"
                    Text="Отмена"
                    Clicked="OnCancelClicked"
                    Style="{StaticResource SecondaryButton}"
                    Grid.Column="1" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>