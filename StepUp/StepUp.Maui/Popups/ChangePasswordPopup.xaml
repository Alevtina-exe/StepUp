<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:popups="clr-namespace:StepUp.Maui.Popups"
    x:Class="StepUp.Maui.Popups.ChangePasswordPopup"
    x:TypeArguments="system:String"
    x:DataType="popups:ChangePasswordPopup"
    BackgroundColor="Transparent">

    <Border
        Style="{StaticResource PopupBorder}">
        <VerticalStackLayout
            Spacing="5">
            <Label
                x:Name="TitleLabel"
                Text="Изменить пароль"
                FontSize="16"
                HorizontalTextAlignment="Center"
                TextColor="Black" />

            <Entry
                x:Name="Password"
                Placeholder="Введите новый пароль"
                TextChanged="OnEntryChanged"
                PlaceholderColor="Black" />

            <Label
                x:Name="ErrorLabel"
                IsVisible="False"
                TextColor="{StaticResource ErrorColor}"
                HorizontalOptions="Center"/>
            
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="5"
                HorizontalOptions="Center">

                <Button
                    x:Name="SaveButton"
                    Text="OK"
                    IsEnabled="False"
                    Clicked="OnSaveClicked"
                    Style="{StaticResource PopupMenuButton}"
                    Grid.Column="0" />
                
                <Button
                    x:Name="CancelButton"
                    Text="Отмена"
                    Clicked="OnCancelClicked"
                    Style="{StaticResource PopupMenuButton}"
                    Grid.Column="1" />
            </Grid>
        </VerticalStackLayout>
    </Border>
    
</toolkit:Popup>