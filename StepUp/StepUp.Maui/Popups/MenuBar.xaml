<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:enums="clr-namespace:StepUp.Presentation.Enums;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Popups.MenuBar"
    x:TypeArguments="enums:MenuAction"
    Background="Transparent">
    <VerticalStackLayout
        Padding="30">
        <Border
            Style="{StaticResource PopupBorder}"
            Padding="16">
            <VerticalStackLayout
                Spacing="8">
                <Button
                    Text="Изменить вес"
                    Style="{StaticResource MenuActionButton}"
                    Clicked="AddWeight_Clicked" />
                <Button
                    Text="Завтрак"
                    Style="{StaticResource MenuActionButton}"
                    Clicked="AddBreakfast_Clicked" />
                <Button
                    Text="Обед"
                    Style="{StaticResource MenuActionButton}"
                    Clicked="AddLunch_Clicked" />
                <Button
                    Text="Ужин"
                    Style="{StaticResource MenuActionButton}"
                    Clicked="AddDinner_Clicked" />
                <Button
                    Text="Перекус"
                    Style="{StaticResource MenuActionButton}"
                    Clicked="AddSnack_Clicked" />
                <Button
                    Text="Физическая нагрузка"
                    Style="{StaticResource MenuActionButton}"
                    Clicked="AddSport_Clicked" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</toolkit:Popup>