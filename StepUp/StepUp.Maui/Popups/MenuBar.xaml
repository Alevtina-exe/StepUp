<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:enums="clr-namespace:StepUp.Presentation.Enums;assembly=StepUp.Presentation"
    x:Class="StepUp.Maui.Popups.MenuBar"
    x:TypeArguments="enums:MenuAction">

    <VerticalStackLayout>
        <Border
            StrokeShape="RoundRectangle 20"
            Stroke="{StaticResource Primary}"
            BackgroundColor="{StaticResource PopupBackground}">

            <VerticalStackLayout
                Spacing="5"
                BackgroundColor="{StaticResource PopupBackground}"
                Padding="10">

                <Button
                    Text="Измерение веса"
                    Style="{StaticResource PopupMenuButton}"
                    Clicked="AddWeight_Clicked" />

                <Button
                    Text="Завтрак"
                    Style="{StaticResource PopupMenuButton}"
                    Clicked="AddBreakfast_Clicked" />

                <Button
                    Text="Обед"
                    Style="{StaticResource PopupMenuButton}"
                    Clicked="AddLunch_Clicked" />

                <Button
                    Text="Ужин"
                    Style="{StaticResource PopupMenuButton}"
                    Clicked="AddDinner_Clicked" />

                <Button
                    Text="Перекус"
                    Style="{StaticResource PopupMenuButton}"
                    Clicked="AddSnack_Clicked" />

                <Button
                    Text="Физическая нагрузка"
                    Style="{StaticResource PopupMenuButton}"
                    Clicked="AddSport_Clicked" />

            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</toolkit:Popup>