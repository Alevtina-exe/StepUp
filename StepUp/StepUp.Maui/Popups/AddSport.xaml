<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:domain="clr-namespace:StepUp.Domain.Entities;assembly=StepUp.Domain"
    x:Class="StepUp.Maui.Popups.AddSport"
    x:TypeArguments="domain:Sport"
    BackgroundColor="Transparent">

    <VerticalStackLayout>
        <Border
            StrokeShape="RoundRectangle 20"
            Stroke="{StaticResource PopupBackground}"
            BackgroundColor="{StaticResource PopupBackground}">
            <StackLayout
                Spacing="5"
                BackgroundColor="Transparent"
                Opacity="0.8">
                <Label
                    x:Name="text"
                    Text="Добавить физ. нагрузку"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    TextColor="Black" />

                <Entry
                    x:Name="NameEntry"
                    Placeholder="Название"
                    TextChanged="Entry_TextChanged"
                    PlaceholderColor="Black" />
                <Entry
                    x:Name="KcalEntry"
                    Placeholder="Количество калорий"
                    Keyboard="Numeric"
                    PlaceholderColor="Black"
                    TextChanged="Entry_TextChanged" />

                <Label
                    x:Name="ErrorLabel"
                    TextColor="Red"
                    HorizontalOptions="Center"
                    IsVisible="False" />

                <StackLayout
                    Orientation="Horizontal"
                    Spacing="5"
                    HorizontalOptions="Center">
                    <Button
                        Text="Отмена"
                        Clicked="CancelButton_Clicked"
                        BackgroundColor="#562fc2"
                        TextColor="White"
                        FontSize="13"
                        CornerRadius="20"
                        WidthRequest="80" />
                    <Button
                        Text="OK"
                        Clicked="OkButton_Clicked"
                        CornerRadius="20"
                        BackgroundColor="#562fc2"
                        TextColor="White"
                        WidthRequest="80" />
                    <Button
                        x:Name="delButton"
                        Text="Удалить"
                        Clicked="DeleteButton_Clicked"
                        CornerRadius="20"
                        FontSize="13"
                        BackgroundColor="#562fc2"
                        TextColor="White"
                        WidthRequest="80" />
                </StackLayout>
            </StackLayout>
        </Border>
    </VerticalStackLayout>
</toolkit:Popup>